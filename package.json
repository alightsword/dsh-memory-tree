{
  "name": "dsh-memory-tree",
  "version": "0.1.0",
  "description": "DSH native plugin: cross-session three-tier memory (transient / short-term / long-term) with write-before-conflict interception",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19 || >=24",
    "dsh": ">=0.2.1-rc.3"
  },
  "scripts": {
    "build": "tsc && npm run build:client",
    "build:client": "esbuild src/client/index.tsx --bundle --format=cjs --charset=utf8 --external:react --outfile=lib/client.js --banner:js=\"window.__ModuleLoader__.load({ id: 'dsh-memory-tree', factory: (require) => { var module = { exports: {} }; var exports = module.exports; Object.defineProperty(exports, Symbol.toStringTag, { value: 'Module' }); const React = require('react');\" --footer:js=\"return module.exports; }});\"",
    "prepare": "npm run build",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node test/e2e.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "external": [],
      "immediately": false
    }
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "memory",
    "long-term-memory"
  ],
  "license": "MIT",
  "author": "linksword239-dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/linksword239-dev/dsh-memory-tree.git"
  },
  "bugs": {
    "url": "https://github.com/linksword239-dev/dsh-memory-tree/issues"
  },
  "homepage": "https://github.com/linksword239-dev/dsh-memory-tree#readme",
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh": ">=0.2.1-rc.3",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh": "0.2.1-rc.3",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.3",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
